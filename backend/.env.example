# AquaNexis Backend Environment Configuration
# Copy to .env and update with secure values

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=aquanexis
DB_PASSWORD=aquanexis
DB_NAME=aquanexis
DATABASE_URL=postgresql+asyncpg://aquanexis:aquanexis@localhost:5432/aquanexis

# Authentication
DEVICE_JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
DEVICE_JWT_ALGORITHM=HS256
DEVICE_JWT_EXPIRY_HOURS=24
API_KEY_SALT=your-salt-min-16-chars

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ML
ML_ENABLED=true
MODEL_ARTIFACT_DIR=/app/models

# Notifications
NOTIFICATION_PROVIDERS=console

# Safety
SAFETY_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console