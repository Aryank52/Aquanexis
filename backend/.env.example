# AquaNexis Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# =============================================================================
# Application
# =============================================================================
APP_ENV=development                 # development, staging, production
APP_HOST=0.0.0.0
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Database (PostgreSQL + TimescaleDB)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=aquanexis
DB_PASSWORD=aquanexis
DB_NAME=aquanexis
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# Authentication & Security
# =============================================================================
# Device JWT - MUST be at least 32 characters, rotate quarterly in production
DEVICE_JWT_SECRET=dev-secret-change-in-production-minimum-32-characters-long
DEVICE_JWT_ALGORITHM=HS256
DEVICE_JWT_EXPIRY_HOURS=24

# API Key salt for hashing (if storing hashed keys)
API_KEY_SALT=dev-salt-change-in-production

# Rate limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Machine Learning
# =============================================================================
ML_ENABLED=true
MODEL_ARTIFACT_DIR=/app/models
ML_ANOMALY_WINDOW_MINUTES=15
ML_RUL_MODEL_NAME=baseline_v1
ML_RETRAIN_SCHEDULE_CRON=0 2 * * 0

# =============================================================================
# Notifications
# =============================================================================
NOTIFICATION_PROVIDERS=console    # console, email, webhook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@aquanexis.local
WEBHOOK_URL=
WEBHOOK_SECRET=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=console                # json or console

# =============================================================================
# Safety System
# =============================================================================
SAFETY_ENABLED=true
SAFETY_ACTION_TIMEOUT_SECONDS=5
SAFETY_DEFAULT_LEAK_ACTION=close_inlet_valve
SAFETY_DEFAULT_PRESSURE_MAX_KPA=600.0
SAFETY_DEFAULT_FLOW_MIN_LPM=0.1
SAFETY_DEFAULT_PUMP_CURRENT_MAX_A=2.5

# =============================================================================
# Simulator (Development Only)
# =============================================================================
SIMULATOR_DEVICE_ID=00000000-0000-0000-0000-000000000001
SIMULATOR_DEVICE_JWT=
SIMULATOR_SENSOR_INTERVAL_SECONDS=10
SIMULATOR_ANOMALY_PROBABILITY=0.05