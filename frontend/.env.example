# AquaNexis Frontend Environment
# Copy to .env for local development

# API base URL (proxied by Vite in dev — leave as /api/v1)
VITE_API_BASE_URL=/api/v1

# WebSocket base URL (direct in dev)
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Default device ID for single-device deployments
VITE_DEVICE_ID=00000000-0000-0000-0000-000000000001

# Set to 'true' in dev if the backend has no /auth/login endpoint
# NEVER set to 'true' in production
VITE_AUTH_DISABLED=false
